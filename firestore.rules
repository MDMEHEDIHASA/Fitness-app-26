rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile document AND every subcollection (workouts, goals, records, ...).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
